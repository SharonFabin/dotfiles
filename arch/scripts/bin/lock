#!/bin/bash

trap 'rm -f /tmp/lock_screen.png /tmp/lock_screen_raw.png' HUP INT TERM EXIT

# Show "Locking..." toast immediately
qs ipc -c noctalia-shell call toast send '{"title":"Locking...","icon":"lock","timeout":3000}' &

# Screenshot immediately (before any processing)
grim /tmp/lock_screen_raw.png

~/dotfiles/arch/scripts/bin/hyprctl_set_laytout_us &

# Blur + composite overlay
magick /tmp/lock_screen_raw.png -scale 10% -scale 1000% \
  \( ~/Pictures/wallpapers/lock_screen/rick_and_morty_lock_shade.png -gravity South -geometry -20x1200 \) \
  -composite /tmp/lock_screen.png
rm -f /tmp/lock_screen_raw.png

# Dismiss toast, dismiss stretch reminder if alarming, and lock
qs ipc -c noctalia-shell call toast dismiss &
qs ipc -c noctalia-shell call plugin:stretch-reminder reset &
swaylock -e -f -i /tmp/lock_screen.png
